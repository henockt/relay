# Server
PORT=8080

# Database (for docker compose)
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=relay

# Database
DATABASE_URL=postgres://user:password@host:5432/relay?sslmode=require

# Auth (Clerk, https://dashboard.clerk.com -> API keys)
CLERK_SECRET_KEY=
# Baked into the frontend at build time, pass as a Docker build arg.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Email (Mailgun)
SMTP_DOMAIN=your-app.example.com
MAILGUN_API_KEY=
MAILGUN_DOMAIN=your-app.example.com
MAILGUN_SIGNING_KEY=
# EU accounts: https://api.eu.mailgun.net/v3
MAILGUN_API_BASE=https://api.mailgun.net/v3

# App URLs
FRONTEND_URL=https://your-app.example.com
# Only needed if the backend is hosted separately from the frontend.
NEXT_PUBLIC_API_URL=
